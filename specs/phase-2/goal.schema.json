{"$id": "https://steroids.local/schemas/goal/v0.1", "$schema": "http://json-schema.org/draft-07/schema#", "description": "Steroids Phase 2 goal object: user-visible outcome spanning 1-5 tasks (TASK_SYSTEM.md hierarchy). P2-1.", "properties": {"acceptance": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array"}, "children": {"description": "child task ids", "items": {"type": "string"}, "type": "array"}, "id": {"minLength": 1, "type": "string"}, "outcome": {"minLength": 1, "type": "string"}, "rq": {"description": "planning-pack requirement tag, e.g. RQ-2", "pattern": "^RQ-[0-9]+$", "type": "string"}, "status": {"enum": ["pending", "active", "blocked", "completed", "cancelled"]}, "title": {"minLength": 1, "type": "string"}}, "required": ["acceptance", "id", "outcome", "title"], "title": "steroids-goal", "type": "object", "version": "v0.1"}